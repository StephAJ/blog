# ---------------------------------------------------------------
# Copy this file to .env.local (dev) or .env (production) and edit.
# ---------------------------------------------------------------

# Public URL of the site — used for canonical URLs, sitemap, RSS, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the SQLite database file lives (relative to the project root).
DATABASE_PATH=./data/blog.db

# Secret used to sign admin session cookies.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Credentials created by `npm run db:seed` for the first admin user.
ADMIN_EMAIL=admin@stephenarthur.org
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Stephen Arthur
